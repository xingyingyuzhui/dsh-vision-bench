{
  "name": "dsh-vision-bench",
  "version": "0.20.6",
  "description": "Vision 台架：会话区调试/上位机点表（倍率/单位/告警上下限、CSV 导入导出、趋势曲线），Keil 编译与日志、产物哈希、OpenOCD 烧录确认、串口报文订阅，Modbus 读点和受控写点（Agent 写点需界面批准），人工操作请求卡、共享任务与时间线，会话绑定与台架事件通知，并安装「Vision模式」Agent 预设。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bench",
    "keil",
    "modbus"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "bench-store.mjs",
    "bench-paths.mjs",
    "bench-fs.mjs",
    "bench-run.mjs",
    "bench-actions.mjs",
    "bench-modbus.mjs",
    "bench-modbus-forward.mjs",
    "bench-listdir.mjs",
    "bench-flash.mjs",
    "bench-keil.mjs",
    "bench-check.mjs",
    "bench-notify.mjs",
    "bench-portlock.mjs",
    "bench-serial-monitor.mjs",
    "bench-prompt.mjs",
    "bench-tool.mjs",
    "bench-preset.mjs",
    "bench-i18n.mjs",
    "bench-styles.mjs",
    "bench-settings.mjs",
    "bench-view.mjs",
    "bench-hmi.mjs",
    "bench-trend.mjs",
    "bench-alarm.mjs",
    "bench-patch.mjs",
    "bench-frames-model.mjs",
    "bench-frames-view.mjs",
    "bench-live.mjs",
    "bench-map.mjs",
    "bench-points.mjs",
    "bench-pollplan.mjs",
    "bench-devices.mjs",
    "bench-targets.mjs",
    "bench-slave.mjs",
    "bench-serial.mjs",
    "bench-journal.mjs",
    "bench-runtime.mjs",
    "bench-io-contract.mjs",
    "bench-io-capability.mjs",
    "bench-io-broker.mjs",
    "bench-modbus-transport.mjs",
    "bench-modbus-commit.mjs",
    "runtime/vision-io-worker.mjs",
    "runtime/io/contract.mjs",
    "runtime/io/connection-manager.mjs",
    "runtime/io/modbus-driver.mjs",
    "runtime/io/rtu-capture-adapter.mjs",
    "runtime/io/frame-ring.mjs",
    "runtime/io/error-map.mjs",
    "runtime/keil_project.py",
    "runtime/keil_build.py",
    "runtime/openocd_flash.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "bench-polling-service.mjs",
    "bench-trend-store.mjs",
    "bench-visualization-model.mjs",
    "bench-visualization-view.mjs",
    "src/ui/common/ui-format.mjs",
    "src/ui/common/state-subscription.mjs",
    "src/ui/common/frame-cache.mjs",
    "src/ui/common/sidebar-scope.mjs",
    "src/ui/common/focus-store.mjs",
    "src/ui/common/agent-reference.mjs",
    "src/ui/common/session-scope.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xingyingyuzhui/dsh-vision-bench.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "lint": "biome ci src docs/architecture",
    "typecheck": "tsc -p tsconfig.check.json",
    "deps:check": "depcruise --config dependency-cruiser.config.mjs src bench-*.mjs host.js runtime/io",
    "test:unit": "node --test test/*.test.mjs",
    "test:coverage": "c8 --reporter=text-summary --reporter=html node --test test/*.test.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "quality": "npm run build:check && npm run lint && npm run typecheck && npm run deps:check && npm run test:unit && npm run pack:check",
    "test": "npm run build:check && npm run test:unit",
    "test:full": "npm run quality"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.12",
    "@tanstack/virtual-core": "3.13.12",
    "fast-json-patch": "3.1.1",
    "modbus-serial": "8.0.25",
    "serialport": "13.0.0",
    "uplot": "1.6.32",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20.17.57",
    "c8": "^10.1.3",
    "dependency-cruiser": "^16.10.2",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.8.3"
  }
}
