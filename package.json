{
  "name": "dsh-vision-bench",
  "version": "0.17.1",
  "description": "Vision 台架：会话区调试/上位机点表（倍率/单位/告警上下限、CSV 导入导出、趋势曲线），Keil 编译与日志、产物哈希、OpenOCD 烧录确认、串口监视，Modbus 读点和受控写点（Agent 写点需界面批准），人工操作请求卡，共享任务与时间线，会话绑定与台架事件通知，并安装「台架模式」Agent 预设。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bench",
    "keil",
    "modbus"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "bench-store.mjs",
    "bench-paths.mjs",
    "bench-fs.mjs",
    "bench-run.mjs",
    "bench-actions.mjs",
    "bench-modbus.mjs",
    "bench-flash.mjs",
    "bench-keil.mjs",
    "bench-check.mjs",
    "bench-notify.mjs",
    "bench-portlock.mjs",
    "bench-serial-monitor.mjs",
    "bench-prompt.mjs",
    "bench-tool.mjs",
    "bench-preset.mjs",
    "bench-i18n.mjs",
    "bench-styles.mjs",
    "bench-settings.mjs",
    "bench-view.mjs",
    "bench-hmi.mjs",
    "bench-overview.mjs",
    "bench-live.mjs",
    "bench-map.mjs",
    "bench-points.mjs",
    "bench-devices.mjs",
    "bench-slave.mjs",
    "bench-serial.mjs",
    "bench-journal.mjs",
    "bench-runtime.mjs",
    "runtime/keil_project.py",
    "runtime/keil_build.py",
    "runtime/modbus_read.py",
    "runtime/modbus_write.py",
    "runtime/openocd_flash.py",
    "runtime/serial_monitor.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xingyingyuzhui/dsh-vision-bench.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "test": "npm run build:check && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
