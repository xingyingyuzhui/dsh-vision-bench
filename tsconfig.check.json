{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": [
    "src/domain/**/*.mjs",
    "src/application/**/*.mjs",
    "src/infrastructure/**/*.mjs",
    "src/interfaces/**/*.mjs",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "client.js", "test", "coverage", "bench-*.mjs"]
}
